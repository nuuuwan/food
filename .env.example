# Frontend backend target switch
REACT_APP_VERCEL_TARGET=local
REACT_APP_LOCAL_API_BASE_URL=http://localhost:3001
REACT_APP_REMOTE_API_BASE_URL=https://your-project.vercel.app
# Optional hard override (highest priority)
# REACT_APP_API_BASE_URL=
# Optional fallback to local when remote fails in local dev
REACT_APP_ENABLE_LOCAL_FALLBACK=false

# Backend Gemini config (used by Vercel API routes)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Required for local blob writes with `vercel dev`
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
